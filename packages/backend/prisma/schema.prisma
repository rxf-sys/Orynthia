// ===================================================
// Orynthia - Prisma Schema
// ===================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Benutzer ----------
model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String    @map("password_hash")
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  
  // 2FA
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?  @map("two_factor_secret")
  

  // Passwort-Reset
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")

  // Einstellungen
  notificationSettings Json? @map("notification_settings")
  dashboardLayout      Json? @map("dashboard_layout")

  // Status
  isActive       Boolean   @default(true) @map("is_active")
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  
  // Timestamps
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  lastLoginAt    DateTime? @map("last_login_at")
  
  // Relations
  bankAccounts   BankAccount[]
  categories     Category[]
  budgets        Budget[]
  recurringPayments RecurringPayment[]
  savingsGoals   SavingsGoal[]
  notifications  Notification[]
  bankConnections BankConnection[]
  contracts      Contract[]
  investments    InvestmentPosition[]
  sessions       UserSession[]
  taskLists      TaskList[]
  tasks          Task[]
  calendars      Calendar[]
  integrations   ExternalIntegration[]
  recipes        Recipe[]
  lists          List[]
  mealPlan       MealPlanEntry[]
  notes          Note[]
  trips          Trip[]
  entityLinks    EntityLink[]

  @@map("users")
}

// ---------- Refresh-Sessions (Multi-Device) ----------
// Ein Eintrag pro angemeldetem Gerät/Browser. Der Refresh-Token liegt nur
// als bcrypt-Hash vor und rotiert bei jedem Refresh innerhalb der Session.
model UserSession {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @map("token_hash")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  expiresAt  DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// ---------- Wertanlagen / Depot ----------
enum InvestmentType {
  STOCK
  ETF
  FUND
  CRYPTO
  BOND
  OTHER
}

model InvestmentPosition {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  bankAccountId   String?  @map("bank_account_id")

  symbol          String   // z.B. AAPL, BTC, IE00B4L5Y983
  name            String   // z.B. "Apple Inc.", "iShares Core MSCI World"
  type            InvestmentType @default(STOCK)
  quantity        Decimal  @db.Decimal(20, 8)
  averagePrice    Decimal  @map("average_price") @db.Decimal(20, 8)
  currentPrice    Decimal? @map("current_price") @db.Decimal(20, 8)
  currency        String   @default("EUR")

  purchaseDate    DateTime? @map("purchase_date")
  lastPriceUpdate DateTime? @map("last_price_update")
  notes           String?

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, type])
  @@map("investment_positions")
}

// ---------- Bankkonten ----------
model BankAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  
  bankName        String    @map("bank_name")
  accountName     String    @map("account_name")
  iban            String?
  bic             String?
  accountType     AccountType @default(CHECKING) @map("account_type")
  
  // Kontostand
  balance         Decimal   @default(0) @db.Decimal(12, 2)
  currency        String    @default("EUR")
  
  // Banking API Verbindung (verschlüsselt)
  externalId      String?   @map("external_id")
  accessToken     String?   @map("access_token") // AES-256 verschlüsselt
  refreshToken    String?   @map("refresh_token") // AES-256 verschlüsselt
  consentExpiry   DateTime? @map("consent_expiry")
  
  // Status
  isActive        Boolean   @default(true) @map("is_active")
  lastSynced      DateTime? @map("last_synced")
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  investments     InvestmentPosition[]

  @@index([userId])
  @@map("bank_accounts")
}

enum AccountType {
  CHECKING    // Girokonto
  SAVINGS     // Sparkonto
  CREDIT_CARD // Kreditkarte
  DEPOT       // Wertpapierdepot
  LOAN        // Kredit
  OTHER       // Sonstige
}

// ---------- Transaktionen ----------
model Transaction {
  id              String    @id @default(uuid())
  bankAccountId   String    @map("bank_account_id")
  categoryId      String?   @map("category_id")
  
  // Transaktionsdaten
  amount          Decimal   @db.Decimal(12, 2)
  currency        String    @default("EUR")
  date            DateTime
  valueDate       DateTime? @map("value_date")
  
  // Details
  purpose         String?   // Verwendungszweck
  counterpartName String?   @map("counterpart_name")
  counterpartIban String?   @map("counterpart_iban")
  
  // Typ & Status
  type            TransactionType @default(OTHER)
  recurringPaymentId String? @map("recurring_payment_id")
  
  // Externe Referenz
  externalId      String?   @map("external_id")
  
  // Notizen
  notes           String?
  tags            String[]  @default([])
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  category        Category?   @relation(fields: [categoryId], references: [id])
  recurringPayment RecurringPayment? @relation(fields: [recurringPaymentId], references: [id])

  @@unique([bankAccountId, externalId])
  @@index([bankAccountId, date])
  @@index([categoryId])
  @@index([date])
  @@index([type])
  @@map("transactions")
}

enum TransactionType {
  INCOME          // Einnahme
  EXPENSE         // Ausgabe
  TRANSFER        // Umbuchung
  STANDING_ORDER  // Dauerauftrag
  DIRECT_DEBIT    // Lastschrift
  OTHER           // Sonstige
}

// ---------- Kategorien ----------
model Category {
  id          String    @id @default(uuid())
  userId      String?   @map("user_id") // null = System-Kategorie
  
  name        String
  icon        String?
  color       String?   // Hex-Farbcode
  parentId    String?   @map("parent_id")
  isSystem    Boolean   @default(false) @map("is_system")
  
  // Keywords für Auto-Kategorisierung
  keywords    String[]  @default([])
  
  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryHierarchy")
  transactions Transaction[]
  budgets      Budget[]
  recurringPayments RecurringPayment[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

// ---------- Budgets ----------
model Budget {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  categoryId  String    @map("category_id")
  
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("EUR")
  period      BudgetPeriod @default(MONTHLY)
  
  // Zeitraum
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  
  // Status
  isActive    Boolean   @default(true) @map("is_active")
  
  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, period])
  @@map("budgets")
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// ---------- Wiederkehrende Zahlungen (Abos) ----------
model RecurringPayment {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  categoryId  String?   @map("category_id")

  name        String
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("EUR")
  frequency   PaymentFrequency @default(MONTHLY)

  // Details
  counterpartName String? @map("counterpart_name")
  nextDueDate DateTime?  @map("next_due_date")
  lastChargeDate DateTime? @map("last_charge_date")

  // Status
  isActive    Boolean   @default(true) @map("is_active")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category? @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@map("recurring_payments")
}

enum PaymentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  BIANNUALLY
  YEARLY
}

// ---------- Sparziele ----------
model SavingsGoal {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  
  name        String
  targetAmount Decimal  @map("target_amount") @db.Decimal(12, 2)
  currentAmount Decimal @default(0) @map("current_amount") @db.Decimal(12, 2)
  currency    String    @default("EUR")
  
  // Deadline
  deadline    DateTime?
  icon        String?
  color       String?
  
  // Status
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  
  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("savings_goals")
}

// ---------- Verträge ----------
model Contract {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")

  // Vertragsdaten
  name            String    // z.B. "Haftpflichtversicherung", "Strom Vattenfall"
  provider        String    // z.B. "Allianz", "Vattenfall", "Telekom"
  contractType    ContractType @map("contract_type")

  // Kosten
  monthlyCost     Decimal?  @map("monthly_cost") @db.Decimal(12, 2)
  yearlyCost      Decimal?  @map("yearly_cost") @db.Decimal(12, 2)
  billingCycle    BillingCycle @default(MONTHLY) @map("billing_cycle")

  // Vertragsdetails
  contractNumber  String?   @map("contract_number")
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  cancellationDate DateTime? @map("cancellation_date") // Kündigungsfrist
  noticePeriod    String?   @map("notice_period") // z.B. "3 Monate"
  autoRenewal     Boolean   @default(true) @map("auto_renewal")

  // Provider-spezifisch (Versicherung, Strom etc.)
  details         Json?     // Flexible Zusatzinfos (kWh-Preis, Deckungssumme, Tarif etc.)

  // Erkennungsmuster
  counterpartName String?   @map("counterpart_name") // Für Auto-Erkennung
  counterpartIban String?   @map("counterpart_iban")

  // Durchschnitt aus Transaktionen
  avgMonthlyAmount Decimal? @map("avg_monthly_amount") @db.Decimal(12, 2)
  transactionCount Int      @default(0) @map("transaction_count")
  lastChargeDate  DateTime? @map("last_charge_date")

  // Status
  isActive        Boolean   @default(true) @map("is_active")
  isAutoDetected  Boolean   @default(false) @map("is_auto_detected")

  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("contracts")
}

enum ContractType {
  INSURANCE_LIABILITY     // Haftpflicht
  INSURANCE_HOUSEHOLD     // Hausrat
  INSURANCE_HEALTH        // Krankenversicherung
  INSURANCE_DENTAL        // Zahnzusatzversicherung
  INSURANCE_LIFE          // Lebensversicherung
  INSURANCE_CAR           // KFZ-Versicherung
  INSURANCE_LEGAL         // Rechtsschutz
  INSURANCE_DISABILITY    // Berufsunfähigkeit
  INSURANCE_OTHER         // Sonstige Versicherung
  ENERGY_ELECTRICITY      // Strom
  ENERGY_GAS              // Gas
  TELECOM_MOBILE          // Mobilfunk
  TELECOM_INTERNET        // Internet/DSL
  TELECOM_LANDLINE        // Festnetz
  STREAMING               // Netflix, Spotify etc.
  GYM                     // Fitnessstudio
  SUBSCRIPTION            // Sonstige Abos
  RENT                    // Miete
  LEASE                   // Leasing
  LOAN                    // Kredit/Darlehen
  OTHER                   // Sonstige
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  BIANNUALLY
  YEARLY
}

// ---------- Benachrichtigungen ----------
model Notification {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  
  type        NotificationType
  title       String
  message     String
  data        Json?     // Zusätzliche Daten
  
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  
  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  BUDGET_WARNING     // Budget fast aufgebraucht
  BUDGET_EXCEEDED    // Budget überschritten
  LARGE_TRANSACTION  // Große Transaktion erkannt
  RECURRING_DETECTED // Neues Abo erkannt
  SAVINGS_MILESTONE  // Sparziel Meilenstein
  SYNC_ERROR         // Bank-Sync Fehler
  TASK_DUE           // Aufgabe fällig/überfällig
  EVENT_REMINDER     // Termin-Erinnerung
  CALENDAR_SYNC_ERROR // Kalender-Sync Fehler (ICS/Google)
  SYSTEM             // System-Nachricht
}

// ---------- Aufgaben ----------
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// Bewusst einfache, eigene Wiederholungs-Frequenz (kein RFC-5545-Parser):
// beim Abschluss einer wiederkehrenden Aufgabe wird die nächste Instanz
// aus dueAt + Frequenz erzeugt.
enum TaskRecurrence {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

model TaskList {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  color     String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, name])
  @@index([userId])
  @@map("task_lists")
}

model Task {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  taskListId  String?       @map("task_list_id")
  title       String
  notes       String?
  priority    TaskPriority  @default(MEDIUM)
  dueAt       DateTime?     @map("due_at")
  completedAt DateTime?     @map("completed_at")
  recurrence  TaskRecurrence?
  calendarEventId String?   @map("calendar_event_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskList      TaskList?      @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)

  @@index([userId, completedAt])
  @@index([userId, dueAt])
  @@index([taskListId])
  @@map("tasks")
}

// ---------- Kalender ----------
// source LOCAL = in Orynthia gepflegt; GOOGLE/APPLE/ICS sind für die
// Sync-Provider der Phase 2 vorbereitet (CalendarProviderInterface).
enum CalendarSource {
  LOCAL
  GOOGLE
  APPLE
  ICS
}

enum EventRecurrence {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

model Calendar {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  name      String
  color     String?
  isDefault Boolean        @default(false) @map("is_default")
  source    CalendarSource @default(LOCAL)
  externalId String?       @map("external_id")
  readOnly  Boolean        @default(false) @map("read_only")

  // Externe Anbindung (ICS/Google); syncToken für inkrementellen Google-Sync
  integrationId String?    @map("integration_id")
  syncToken     String?    @map("sync_token")

  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration ExternalIntegration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  events      CalendarEvent[]

  @@unique([userId, name])
  @@index([userId])
  @@index([integrationId])
  @@map("calendars")
}

// ---------- Rezepte ----------
enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
}

model Recipe {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  title       String
  description String?
  imageUrl    String? @map("image_url")

  prepMinutes Int @default(0) @map("prep_minutes")
  cookMinutes Int @default(0) @map("cook_minutes")
  servings    Int @default(2)

  difficulty  RecipeDifficulty @default(EASY)
  // Freie String-Arrays statt Enums: Mahlzeiten-/Ernährungs-Kategorien
  // sollen ohne Migration erweiterbar bleiben (Muster: Transaction.tags)
  mealTypes   String[] @default([]) @map("meal_types")
  dietary     String[] @default([])
  tags        String[] @default([])

  instructions String[] @default([])
  nutrition    Json?
  isFavorite   Boolean  @default(false) @map("is_favorite")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  listItems   ListItem[]
  mealPlan    MealPlanEntry[]

  @@index([userId])
  @@index([userId, isFavorite])
  @@map("recipes")
}

// ---------- Meal-Planner (Rezepte ↔ Wochenplan) ----------
enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// Ein geplantes Essen an einem Tag. Bewusst eigene Entität statt
// Kalender-Termin: der Wochenplan hat eigene Semantik (Portionen,
// Slot statt Uhrzeit) und soll den Kalender nicht mit Pseudo-Terminen
// füllen – die Kalender-Ansicht blendet ihn als eigenen Layer ein.
model MealPlanEntry {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  recipeId String?  @map("recipe_id")
  /// Freitext für Mahlzeiten ohne hinterlegtes Rezept ("Reste", "Essen gehen")
  title    String?
  date     DateTime @db.Date
  slot     MealSlot @default(DINNER)
  servings Int      @default(2)
  note     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("meal_plan_entries")
}

model RecipeIngredient {
  id        String   @id @default(uuid())
  recipeId  String   @map("recipe_id")
  name      String
  amount    Decimal? @db.Decimal(10, 2)
  unit      String?
  sortOrder Int      @default(0) @map("sort_order")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("recipe_ingredients")
}

// ---------- Listen ----------
enum ListType {
  SHOPPING  // Einkaufsliste
  PACKING   // Packliste
  CHECKLIST // Checkliste
  WISHLIST  // Wunschliste
  GENERIC   // Allgemeine Liste
}

model List {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  type      ListType @default(SHOPPING)
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ListItem[]

  @@unique([userId, name])
  @@index([userId])
  @@map("lists")
}

model ListItem {
  id        String   @id @default(uuid())
  listId    String   @map("list_id")
  name      String
  amount    Decimal? @db.Decimal(10, 2)
  unit      String?
  checked   Boolean  @default(false)
  sortOrder Int      @default(0) @map("sort_order")
  recipeId  String?  @map("recipe_id") // Herkunft „aus Rezept übernommen"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  list   List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([listId])
  @@map("list_items")
}

// ---------- Notizen ----------
model Note {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  title   String?
  content String   @default("")
  tags    String[] @default([])
  color   String?
  pinned  Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pinned])
  @@index([userId, updatedAt])
  @@map("notes")
}

// ---------- Reisen ----------
enum TripStatus {
  PLANNED
  ONGOING
  DONE
}

// Reisen bündeln Termine, Packlisten und Notizen zu einem Vorhaben.
// Das Reisebudget ist bewusst nur eine Planungsgröße im Modul – es
// besteht keinerlei Verbindung zu Konten oder Transaktionen.
model Trip {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  title       String
  destination String?
  startDate   DateTime   @map("start_date") @db.Date
  endDate     DateTime   @map("end_date") @db.Date
  budgetAmount Decimal?  @map("budget_amount") @db.Decimal(12, 2)
  currency    String     @default("EUR")
  status      TripStatus @default(PLANNED)
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@map("trips")
}

// ---------- Generische Verknüpfungen ----------
// Für lose n:m-Beziehungen zwischen Alltags-Modulen (z. B. Reise ↔ Termin,
// Reise ↔ Packliste, Notiz ↔ Termin). Harte, häufige Beziehungen bleiben
// bewusst direkte Fremdschlüssel (ListItem→Recipe, Task→CalendarEvent).
// Finanz-Entitäten sind hier absichtlich NICHT verknüpfbar – Banking-Daten
// bleiben von den Alltags-Modulen getrennt.
enum LinkableType {
  TRIP
  CALENDAR_EVENT
  TASK
  LIST
  NOTE
  RECIPE
}

model EntityLink {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  sourceType LinkableType @map("source_type")
  sourceId   String       @map("source_id")
  targetType LinkableType @map("target_type")
  targetId   String       @map("target_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId, targetType, targetId])
  @@index([userId, sourceType, sourceId])
  @@index([userId, targetType, targetId])
  @@map("entity_links")
}

// ---------- Externe Integrationen (Token-Vault) ----------
// Credentials (OAuth-Refresh-Token, ICS-URL) liegen ausschließlich
// AES-256-GCM-verschlüsselt in credentialEnc – nie im Klartext, nie in Logs.
enum IntegrationProvider {
  GOOGLE_CALENDAR
  ICS
  APPLE_CALDAV // vorbereitet für Phase 2b
}

enum IntegrationStatus {
  CONNECTED
  ERROR
  REVOKED
}

model ExternalIntegration {
  id            String              @id @default(uuid())
  userId        String              @map("user_id")
  provider      IntegrationProvider
  label         String?
  credentialEnc String              @map("credential_enc")
  status        IntegrationStatus   @default(CONNECTED)
  lastSyncAt    DateTime?           @map("last_sync_at")
  lastError     String?             @map("last_error")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendars Calendar[]

  @@index([userId])
  @@map("external_integrations")
}

model CalendarEvent {
  id          String   @id @default(uuid())
  calendarId  String   @map("calendar_id")
  title       String
  description String?
  location    String?
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  isAllDay    Boolean  @default(false) @map("is_all_day")
  reminderMinutes Int? @map("reminder_minutes")

  // Einfache Wiederholung (Frequenz + optionales Ende); Expansion der
  // Instanzen erfolgt zur Laufzeit im CalendarService.
  recurrence         EventRecurrence?
  recurrenceInterval Int?             @map("recurrence_interval")
  recurrenceUntil    DateTime?        @map("recurrence_until")

  // Sync-Provenienz (Phase 2)
  externalId  String?  @map("external_id")
  etag        String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@unique([calendarId, externalId])
  @@index([calendarId, startsAt])
  @@index([startsAt])
  @@map("calendar_events")
}

// ---------- Bank-Verbindungen (Open Banking) ----------
model BankConnection {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")

  provider              String    // "enablebanking" | "finapi"
  externalConnectionId  String    @map("external_connection_id")
  institutionId         String    @map("institution_id")
  institutionName       String?   @map("institution_name")
  institutionLogo       String?   @map("institution_logo")
  sessionId             String?   @map("session_id") // Enable Banking Session ID

  status                String    @default("CREATED") // CREATED, LINKED, EXPIRED, etc.

  // Timestamps
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  expiresAt             DateTime? @map("expires_at")

  // Relations
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("bank_connections")
}
